{
  "name": "clay-jupyter-proxy",
  "version": "0.1.0",
  "description": "Clay Preview JupyterLab extension",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "homepage": "https://github.com/scicloj/clojnder",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{d.ts,js,js.map}",
    "schema"
  ],
  "scripts": {
    "build": "jlpm run build:lib && jlpm run build:labextension",
    "build:prod": "jlpm run clean && jlpm run build:lib:prod && jlpm run build:labextension",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development True .",
    "build:lib": "tsc --sourceMap",
    "build:lib:prod": "tsc",
    "clean": "jlpm run clean:lib && jlpm run clean:labextension",
    "clean:lib": "rimraf lib",
    "clean:labextension": "rimraf ../clay_jupyter_proxy/labextension/static",
    "install:extension": "jlpm run build",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w --sourceMap",
    "watch:labextension": "jupyter labextension watch ."
  },
  "dependencies": {
    "@jupyterlab/application": "4.2.5",
    "@jupyterlab/apputils": "4.3.5",
    "@jupyterlab/coreutils": "6.2.5",
    "@jupyterlab/fileeditor": "4.2.5"
  },
  "devDependencies": {
    "@jupyterlab/builder": "4.2.5",
    "rimraf": "^5.0.0",
    "typescript": "~5.0.2"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "../clay_jupyter_proxy/labextension",
    "schemaDir": "schema"
  }
}
