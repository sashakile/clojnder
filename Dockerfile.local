FROM eclipse-temurin:21-jdk

ENV DEBIAN_FRONTEND=noninteractive \
    CLOJURE_TOOLS_VERSION=1.12.4.1618 \
    BABASHKA_VERSION=1.3.189

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        curl \
        git \
        rlwrap \
        unzip \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/linux-install.sh \
      https://download.clojure.org/install/linux-install-${CLOJURE_TOOLS_VERSION}.sh \
    && chmod +x /tmp/linux-install.sh \
    && /tmp/linux-install.sh \
    && rm -f /tmp/linux-install.sh

RUN curl -fsSL \
      https://github.com/babashka/babashka/releases/download/v${BABASHKA_VERSION}/babashka-${BABASHKA_VERSION}-linux-amd64-static.tar.gz \
      | tar -xz -C /usr/local/bin bb

WORKDIR /workspace
COPY deps.edn /workspace/deps.edn
RUN for i in 1 2 3 4 5; do \
      clojure -P -M:clay-deps && exit 0; \
      echo "clojure prefetch failed, retrying ($i/5)..."; \
      sleep 5; \
    done; \
    echo "clojure prefetch failed after retries"; \
    exit 1
COPY . /workspace

EXPOSE 1971

ENV CLAY_PORT=1971 \
    CLAY_BASE_PATH=/workspace

CMD ["clojure", "-M:clay-local"]
